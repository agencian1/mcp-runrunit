{
  "name": "mcp-runrunit",
  "version": "1.7.0",
  "description": "MCP server for Runrun.it API - Tasks, Comments, Projects",
  "type": "module",
  "main": "dist/index.js",
  "mcpName": "io.github.zNetinho/runrunit-n1",
  "bin": {
    "mcp-runrunit": "dist/index.js"
  },
  "files": [
    "dist",
    "cursor-catalog.json",
    "cursor-skills",
    "cursor-agents",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agencian1/mcp-runrunit.git"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "postbuild": "node scripts/bundle.mjs",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm run build",
    "start": "node --env-file=.env --import ./dist/instrument-http.js dist/server.js",
    "dev": "npm run build && node --env-file=.env --import ./dist/instrument-http.js dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^22.0.0",
    "@sentry/node": "^10.47.0",
    "express": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.0.0"
  }
}
